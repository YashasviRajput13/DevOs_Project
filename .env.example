# ============================================================
# DevOs - Environment Variables Example
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_NAME=devos_db
DB_USER=devos_user
DB_PASSWORD=your_secure_password_here

# Or use a full connection string (takes precedence):
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# --- LLM / Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- LLM / Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- GitHub ---
# Generate a Personal Access Token (classic) with repo scope
GITHUB_TOKEN=your_github_token_here

# --- Auth ---
JWT_SECRET=your_jwt_secret_here
APP_SECRET_KEY=your_app_secret_key_here

# --- Backend CORS ---
# Comma-separated list of allowed origins
# Production: set to your actual Vercel frontend URL
CORS_ORIGINS=http://localhost:3000

# --- App ---
APP_ENV=development
DEBUG=false

# --- Frontend (Vercel) ---
# Set this in the Vercel dashboard as an Environment Variable
# Production value: https://devos-backend-qk4z.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
